/* JSON Workbench —— 主题样式表模板
 *
 * 所有 @TOKEN@ 由 app/widgets/theme.py 用当前调色板替换，深色/浅色共用同一份模板，
 * 避免两套样式表随时间走样。命名约定：
 *   - objectName 选择器（#Sidebar 等）用于结构性部件
 *   - class 属性选择器（QPushButton[class="primary"]）用于按钮语义
 */

/* ---------------------------------------------------------------- 基础 */
* {
    outline: none;
}

QWidget {
    background-color: @BG@;
    color: @TEXT@;
    font-family: @UI_FONT@;
    /* 基础字号由 run.py 里的 QApplication.setFont 统一设置（pointSize），
       这里写 px 会把编辑器的 pointSize 覆盖成 -1，导致缩放失效 */
}

QMainWindow::separator {
    background: @BORDER@;
    width: 1px;
    height: 1px;
}

QDialog {
    background-color: @BG@;
}

QToolTip {
    background-color: @PANEL@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 4px;
    padding: 5px 8px;
}

QSizeGrip {
    background: transparent;
}

/* ---------------------------------------------------------------- 顶部标题栏 */
#HeaderBar {
    background-color: @PANEL_ALT@;
    border-bottom: 1px solid @BORDER@;
    min-height: 46px;
    max-height: 46px;
}

#AppLogo {
    padding-left: 10px;
}

#AppTitle {
    color: @TEXT@;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    padding-left: 8px;
}

#AppSubtitle {
    color: @MUTED@;
    font-size: 11px;
    padding-left: 6px;
}

#HeaderBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 8px;
    margin: 0 2px;
    color: @TEXT@;
}

#HeaderBar QToolButton:hover {
    background-color: @HOVER@;
    border-color: @BORDER@;
}

#HeaderBar QToolButton:pressed,
#HeaderBar QToolButton:checked {
    background-color: @ACCENT_SOFT@;
    border-color: @ACCENT@;
}

/* ---------------------------------------------------------------- 菜单 */
QMenuBar {
    background-color: @PANEL_ALT@;
    color: @TEXT@;
    border: none;
    padding: 2px 6px;
    spacing: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: @HOVER@;
}

QMenuBar::item:pressed {
    background-color: @ACCENT_SOFT@;
}

QMenu {
    background-color: @PANEL@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 26px 6px 12px;
    border-radius: 5px;
    background: transparent;
}

QMenu::item:selected {
    background-color: @ACCENT_SOFT@;
    color: @TEXT@;
}

QMenu::item:disabled {
    color: @DISABLED@;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: @BORDER@;
    margin: 5px 8px;
}

QMenu::icon {
    padding-left: 6px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    margin-left: 6px;
}

/* ---------------------------------------------------------------- 侧边栏 */
#Sidebar {
    background-color: @PANEL_ALT@;
    border-right: 1px solid @BORDER@;
}

#SidebarTitle {
    color: @MUTED@;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 12px 14px 6px 14px;
    background: transparent;
}

#SidebarList {
    background: transparent;
    border: none;
    padding: 2px 6px;
}

#SidebarList::item {
    color: @TEXT@;
    padding: 8px 10px;
    border-radius: 7px;
    margin: 1px 0;
    border: 1px solid transparent;
}

#SidebarList::item:hover {
    background-color: @HOVER@;
}

#SidebarList::item:selected {
    background-color: @ACCENT_SOFT@;
    border-color: @ACCENT@;
    color: @TEXT@;
    font-weight: 600;
}

#SidebarBadge {
    color: @MUTED@;
    background: transparent;
    font-size: 10px;
    padding: 0 10px 10px 10px;
}

/* ---------------------------------------------------------------- 卡片与面板 */
#Card,
.Card {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}

#SidePanel {
    background-color: @PANEL@;
    border-left: 1px solid @BORDER@;
}

#PanelTitle {
    color: @TEXT@;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 10px;
    background-color: @PANEL_ALT@;
    border-bottom: 1px solid @BORDER@;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#PageTitle {
    color: @TEXT@;
    font-size: 17px;
    font-weight: 600;
    padding: 2px 0;
    background: transparent;
}

#PageSubtitle {
    color: @MUTED@;
    font-size: 12px;
    padding: 0 0 4px 0;
    background: transparent;
}

#HintLabel {
    color: @MUTED@;
    font-size: 11px;
    background: transparent;
}

#MutedLabel {
    color: @MUTED@;
    background: transparent;
}

#MonoLabel {
    font-family: @MONO_FONT@;
    background: transparent;
}

/* ---------------------------------------------------------------- 按钮 */
QPushButton,
QToolButton {
    background-color: @PANEL@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 7px;
    padding: 6px 14px;
    color: @TEXT@;
    min-height: 16px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: @HOVER@;
    border-color: @ACCENT@;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: @ACCENT_SOFT@;
    border-color: @ACCENT_PRESSED@;
}

QPushButton:disabled,
QToolButton:disabled {
    color: @DISABLED@;
    background-color: @PANEL_ALT@;
    border-color: @BORDER@;
}

QPushButton[class="primary"] {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: @ACCENT_HOVER@;
    border-color: @ACCENT_HOVER@;
}

QPushButton[class="primary"]:pressed {
    background-color: @ACCENT_PRESSED@;
    border-color: @ACCENT_PRESSED@;
}

QPushButton[class="primary"]:disabled {
    background-color: @BORDER@;
    border-color: @BORDER@;
    color: @DISABLED@;
}

QPushButton[class="danger"] {
    background-color: transparent;
    border-color: @DANGER@;
    color: @DANGER@;
}

QPushButton[class="danger"]:hover {
    background-color: @DANGER@;
    color: @ACCENT_TEXT@;
}

QPushButton[class="ghost"] {
    background: transparent;
    border-color: transparent;
    color: @MUTED@;
}

QPushButton[class="ghost"]:hover {
    background-color: @HOVER@;
    color: @TEXT@;
    border-color: @BORDER@;
}

QToolButton::menu-indicator {
    image: none;
    width: 0;
}

QToolButton[popupMode="1"] {
    padding-right: 22px;
}

/* ---------------------------------------------------------------- 输入控件 */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QKeySequenceEdit {
    background-color: @RAISED@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 7px;
    padding: 5px 8px;
    color: @TEXT@;
    selection-background-color: @SELECTION_BG@;
    selection-color: @SELECTION_TEXT@;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: @ACCENT@;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    color: @DISABLED@;
    background-color: @PANEL_ALT@;
}

QLineEdit[state="invalid"] {
    border-color: @DANGER@;
}

QLineEdit[state="valid"] {
    border-color: @SUCCESS@;
}

QPlainTextEdit#JsonEditor,
QPlainTextEdit#DiffEditor {
    /* 注意：这里不能写 font-size，否则 QSS 的像素字号会覆盖代码里设置的 pointSize，
       导致"字号设置/缩放"失效 */
    font-family: @MONO_FONT@;
    background-color: @RAISED@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px 2px 4px 0;
    selection-background-color: @SELECTION_BG@;
    selection-color: @SELECTION_TEXT@;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @MUTED@;
    width: 0;
    height: 0;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: @PANEL@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 6px;
    selection-background-color: @ACCENT_SOFT@;
    selection-color: @TEXT@;
    padding: 4px;
    outline: none;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    width: 16px;
}

QCheckBox,
QRadioButton {
    spacing: 7px;
    color: @TEXT@;
    background: transparent;
    padding: 2px 0;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: @DISABLED@;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @BORDER_STRONG@;
    background-color: @RAISED@;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: @ACCENT@;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: @PANEL_ALT@;
    border-color: @BORDER@;
}

QGroupBox {
    border: 1px solid @BORDER@;
    border-radius: 9px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    background-color: @PANEL@;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: 2px;
    padding: 0 4px;
    color: @MUTED@;
    background-color: @PANEL@;
}

/* ---------------------------------------------------------------- 标签页 */
QTabWidget::pane {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    background-color: @PANEL@;
    top: -1px;
}

QTabBar {
    qproperty-drawBase: false;
    background: transparent;
}

QTabBar::tab {
    background-color: @PANEL_ALT@;
    color: @MUTED@;
    border: 1px solid @BORDER@;
    border-bottom: none;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 6px 12px;
    margin-right: 3px;
    min-width: 90px;
}

QTabBar::tab:hover {
    color: @TEXT@;
    background-color: @HOVER@;
}

QTabBar::tab:selected {
    background-color: @PANEL@;
    color: @TEXT@;
    border-color: @BORDER_STRONG@;
    font-weight: 600;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QToolButton#TabCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    margin: 2px 2px 2px 6px;
}

QToolButton#TabCloseButton:hover {
    background-color: @DANGER@;
}

QTabBar QToolButton {
    background: transparent;
    border: none;
    padding: 2px;
    margin: 0 2px;
}

QTabBar QToolButton:hover {
    background-color: @HOVER@;
    border-radius: 5px;
}

/* ---------------------------------------------------------------- 视图 */
QTreeView,
QTreeWidget,
QListView,
QListWidget {
    background-color: @RAISED@;
    alternate-background-color: @PANEL_ALT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 3px;
    color: @TEXT@;
    selection-background-color: @SELECTION_BG@;
    selection-color: @SELECTION_TEXT@;
    show-decoration-selected: 0;
    font-family: @MONO_FONT@;
    font-size: 12.5px;
}

QTreeView::item,
QListView::item {
    padding: 3px 4px;
    border-radius: 4px;
    min-height: 18px;
}

QTreeView::item:hover,
QListView::item:hover {
    background-color: @HOVER@;
}

QTreeView::item:selected,
QListView::item:selected {
    background-color: @SELECTION_BG@;
    color: @SELECTION_TEXT@;
}

QTreeView::branch {
    background: transparent;
    border: none;
}

QTableView,
QTableWidget {
    background-color: @RAISED@;
    alternate-background-color: @PANEL_ALT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    gridline-color: @BORDER@;
    color: @TEXT@;
    selection-background-color: @SELECTION_BG@;
    selection-color: @SELECTION_TEXT@;
}

QTableView::item,
QTableWidget::item {
    padding: 4px 6px;
    border: none;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: @SELECTION_BG@;
    color: @SELECTION_TEXT@;
}

QHeaderView {
    background-color: @PANEL_ALT@;
    border: none;
}

QHeaderView::section {
    background-color: @PANEL_ALT@;
    color: @MUTED@;
    border: none;
    border-right: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER@;
    padding: 6px 8px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: @PANEL_ALT@;
    border: none;
    border-bottom: 1px solid @BORDER@;
}

/* 结果/日志类视图用等宽字体，普通列表用界面字体 */
#PlainList,
#ResultList {
    font-family: @UI_FONT@;
    font-size: 13px;
}

/* ---------------------------------------------------------------- 分隔条 */
QSplitter::handle {
    background-color: @BORDER@;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: @ACCENT@;
}

/* ---------------------------------------------------------------- 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px 2px 2px 0;
}

QScrollBar::handle:vertical {
    background: @SCROLL@;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: @SCROLL_HOVER@;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 0 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background: @SCROLL@;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: @SCROLL_HOVER@;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------------------------------------------------------------- 状态栏 */
QStatusBar {
    background-color: @PANEL_ALT@;
    border-top: 1px solid @BORDER@;
    color: @MUTED@;
    font-size: 11.5px;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: @MUTED@;
    background: transparent;
    padding: 0 8px;
    font-size: 11.5px;
}

#StatusDivider {
    color: @BORDER_STRONG@;
    padding: 0;
    background: transparent;
}

#StatusValid {
    color: @SUCCESS@;
    font-weight: 600;
}

#StatusInvalid {
    color: @DANGER@;
    font-weight: 600;
}

#StatusProgress {
    color: @ACCENT@;
}

/* ---------------------------------------------------------------- 进度条 */
QProgressBar {
    background-color: @RAISED@;
    border: 1px solid @BORDER@;
    border-radius: 5px;
    text-align: center;
    color: @TEXT@;
    height: 12px;
    font-size: 10px;
}

QProgressBar::chunk {
    background-color: @ACCENT@;
    border-radius: 4px;
}

/* ---------------------------------------------------------------- 工具栏 */
QToolBar {
    background-color: @PANEL_ALT@;
    border: none;
    border-bottom: 1px solid @BORDER@;
    padding: 4px 6px;
    spacing: 4px;
}

QToolBar::separator {
    background: @BORDER@;
    width: 1px;
    margin: 4px 6px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton:hover {
    background-color: @HOVER@;
    border-color: @BORDER@;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: @ACCENT_SOFT@;
    border-color: @ACCENT@;
}

/* ---------------------------------------------------------------- 对话框按钮 */
QDialogButtonBox QPushButton {
    min-width: 76px;
}

/* ---------------------------------------------------------------- 解包提示条 */
#UnwrapBar {
    background-color: @DIFF_MOD@;
    border: 1px solid @WARNING@;
    border-radius: 8px;
}

#UnwrapBar QLabel {
    background: transparent;
    color: @TEXT@;
    font-size: 12px;
}

/* ---------------------------------------------------------------- 查找替换条 */
#FindReplaceBar {
    background-color: @PANEL@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 8px;
}

#FindReplaceBar QLabel {
    background: transparent;
    color: @MUTED@;
}

/* ---------------------------------------------------------------- 徽章/状态点 */
#BadgeOk {
    color: @SUCCESS@;
    background: transparent;
    font-weight: 600;
}

#BadgeError {
    color: @DANGER@;
    background: transparent;
    font-weight: 600;
}

#BadgeWarning {
    color: @WARNING@;
    background: transparent;
    font-weight: 600;
}

/* ---------------------------------------------------------------- 滚动区 */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}
